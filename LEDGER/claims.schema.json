{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAP v4.0 claim registry; structural validation is not evidence certification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "claims"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programme",
        "version",
        "state",
        "last_updated",
        "base_doi",
        "new_doi",
        "new_pi_approval",
        "coverage",
        "total_claims"
      ],
      "properties": {
        "programme": {
          "type": "string"
        },
        "version": {
          "const": "4.0"
        },
        "state": {
          "const": "working-draft"
        },
        "last_updated": {
          "type": "string"
        },
        "base_doi": {
          "type": "string"
        },
        "new_doi": {
          "type": "null"
        },
        "new_pi_approval": {
          "type": "null"
        },
        "coverage": {
          "type": "string"
        },
        "total_claims": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "evidence_kind",
          "status",
          "observable",
          "method",
          "tension_status",
          "scope",
          "evidence_class",
          "value",
          "unit",
          "uncertainty",
          "reproduction_command",
          "dependencies",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RAP-[MRPFG][0-9]{3}$"
          },
          "statement": {
            "type": "string"
          },
          "evidence_kind": {
            "enum": [
              "calibration",
              "conditional-mathematics",
              "definition",
              "document-state",
              "empirical-reference",
              "exact-arithmetic",
              "input",
              "interpretation",
              "open-physical-bridge",
              "policy",
              "reported-computation",
              "reported-software"
            ]
          },
          "status": {
            "enum": [
              "argument",
              "argument_and_finite_checks",
              "calibrated",
              "definition",
              "exact_finite_check",
              "historical_only",
              "open",
              "pending_source_audit",
              "policy",
              "quarantined",
              "reference_not_derived",
              "reported_not_reproduced"
            ]
          },
          "observable": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "tension_status": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "evidence_class": {
            "enum": [
              "A",
              "A-",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "uncertainty": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "value",
              "meaning"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reported",
                  "not_supplied",
                  "not_applicable"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "meaning": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "reproduction_command": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "anchor"
            ],
            "properties": {
              "path": {
                "const": "manuscript/RAP_v4_0.tex"
              },
              "anchor": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
